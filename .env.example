# REQUIRED in production: your real domain, no trailing slash (used for SEO, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 4: contact form (https://emailjs.com)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Server-only key required when EmailJS API security is in strict mode
EMAILJS_PRIVATE_KEY=
# In the EmailJS template Content, include {{message}} so the inquiry body is rendered.
# Where inquiries are delivered (defaults to the email in data/site.config.ts)
CONTACT_TO_EMAIL=

# Phase 5 (analytics, optional). Cookie-free Plausible; nothing loads until this is set.
# Use your domain without https://, e.g. yourdomain.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: self-hosted or proxied script URL
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Optional: Google Search Console HTML-tag verification token (or verify by DNS instead)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
